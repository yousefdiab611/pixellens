{
  "manifest_version": 3,
  "name": "PixelLens — Design Inspector",
  "version": "1.3.9",
  "minimum_chrome_version": "110",
  "description": "Personal local design inspector, measurements, colors, fonts and exports By Yousef Diab",
  "permissions": [
    "activeTab",
    "scripting",
    "declarativeNetRequestWithHostAccess",
    "storage"
  ],
  "optional_permissions": [
    "downloads"
  ],
  "optional_host_permissions": [
    "https://*/*",
    "http://*/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    },
    "default_title": "PixelLens — عدسة التصميم"
  },
  "commands": {
    "_execute_action": {
      "suggested_key": {
        "default": "Alt+R"
      },
      "description": "Toggle PixelLens"
    },
    "inspect": {
      "suggested_key": {
        "default": "Alt+I"
      },
      "description": "Turn on the inspector"
    },
    "measure": {
      "suggested_key": {
        "default": "Alt+M"
      },
      "description": "Turn on distance measurement"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "short_name": "PixelLens"
}
